# Variables para Endpoints y Modelos Gratuitos de IA
# Copia este archivo a .env e ingresa tus llaves (API Keys) obtenidas de cada proveedor.

# Google AI Studio (Gratis) - Modelo: gemini-1.5-pro / gemini-2.0-flash
# Consíguela en: https://aistudio.google.com/
GEMINI_API_KEY=tu_api_key_de_google_ai_studio_aqui

# Groq Cloud (Ultra Rápido / Gratis) - Modelo: qwen-2.5-coder-32b / llama-3.3-70b
# Consíguela en: https://console.groq.com/
GROQ_API_KEY=tu_api_key_de_groq_aqui

# OpenRouter (Modelos Gratuitos Unificados)
# Consíguela en: https://openrouter.ai/
OPENROUTER_API_KEY=tu_api_key_de_openrouter_aqui

# Ollama Local (Offline / Gratis) - Modelo: qwen2.5-coder:7b
# Endpoint local predeterminado
OLLAMA_BASE_URL=http://localhost:11434
